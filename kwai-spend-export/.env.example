# 复制成 .env 后填写。.env 已被 .gitignore 排除，不会进仓库。
# 飞书自建应用（开发者后台 -> 应用详情页）
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# 电子表格 URL 里 /sheets/ 后面那一长串
FEISHU_SPREADSHEET_TOKEN=shtcnXXXXXXXXXXXXXXXX
# 工作表 ID，URL 里 ?sheet= 后面那段
FEISHU_SHEET_ID=xxxxxx
# 可选：飞书群机器人 webhook，任务失败时告警
FEISHU_WEBHOOK=
